<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SecuriTech Sénégal – Vidéosurveillance, interphonie et réseaux</title>
<meta name="description" content="Installation de caméras de surveillance, vidéophones, interphones et câblage réseau au Sénégal.">
<style>
:root{
  --bg:#f6f8fc;--surface:#ffffff;--text:#0f1b2d;--muted:#52627a;
  --brand:#1456c8;--brand-dark:#0c3c91;--accent:#25d366;--border:#dbe3ef;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#0b1220;--surface:#131d30;--text:#e8eefb;--muted:#9fb0cb;--brand:#4c8dff;--brand-dark:#2f6fe0;--border:#24324b}
}
:root[data-theme="dark"]{--bg:#0b1220;--surface:#131d30;--text:#e8eefb;--muted:#9fb0cb;--brand:#4c8dff;--brand-dark:#2f6fe0;--border:#24324b}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.6}
a{color:inherit}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
header{background:var(--surface);border-bottom:1px solid var(--border)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.1rem;text-decoration:none}
.logo small{display:block;font-weight:500;font-size:.7rem;color:var(--muted)}
nav{display:flex;gap:18px;flex-wrap:wrap}
nav a{text-decoration:none;color:var(--muted);font-size:.95rem}
nav a:hover{color:var(--brand)}
.hero{padding:56px 0 48px;text-align:center}
.hero h1{font-size:clamp(1.9rem,6vw,3rem);line-height:1.15;margin:0 0 14px}
.hero h1 span{color:var(--brand)}
.hero p{max-width:620px;margin:0 auto 26px;color:var(--muted);font-size:1.05rem}
.btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn{display:inline-block;padding:13px 22px;border-radius:12px;font-weight:700;text-decoration:none;border:2px solid var(--brand);background:var(--brand);color:#fff}
.btn:hover{background:var(--brand-dark);border-color:var(--brand-dark)}
.btn.alt{background:transparent;color:var(--brand)}
.btn.alt:hover{background:var(--brand);color:#fff}
.btn.wa{background:var(--accent);border-color:var(--accent);color:#06210f}
section{padding:44px 0}
h2{font-size:1.6rem;margin:0 0 6px;text-align:center}
.sub{text-align:center;color:var(--muted);margin:0 0 28px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:22px}
.card .ic{font-size:1.8rem;margin-bottom:8px}
.card h3{margin:0 0 6px;font-size:1.1rem}
.card p{margin:0;color:var(--muted);font-size:.95rem}
.why{background:var(--surface);border-block:1px solid var(--border)}
.cta{text-align:center;background:var(--brand);color:#fff;border-radius:20px;padding:36px 20px}
.cta p{margin:0 auto 20px;max-width:520px;opacity:.92}
.cta .btn{background:#fff;color:var(--brand-dark);border-color:#fff}
.contact{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.contact .card{text-align:center}
.contact a{color:var(--brand);font-weight:700;text-decoration:none;word-break:break-word}
.price h3{margin:0 0 8px}
.price .amount{font-size:1.6rem;font-weight:800;color:var(--brand);margin-bottom:10px}
.price ul{margin:0;padding-left:18px;color:var(--muted);font-size:.95rem}
footer{padding:26px 0;text-align:center;color:var(--muted);font-size:.85rem;border-top:1px solid var(--border)}
</style>
</head>
